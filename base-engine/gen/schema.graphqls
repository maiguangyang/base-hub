enum AccountStatus {
  ACTIVE
  DISABLED
}

enum OrganizationType {
  HEADQUARTERS
  FRANCHISE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

enum StoreAccessMode {
  ALL_STORES
  SELECTED_STORES
}

enum RoleKind {
  HQ_SUPER_ADMIN
  FRANCHISE_OWNER
  CUSTOM
}

enum PermissionScope {
  SYSTEM
  TENANT
}

enum StoreLifecycle {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
}

enum StoreBusinessStatus {
  OPEN
  CLOSED
}

enum WorkspaceType {
  DISCOVERY
  HEADQUARTERS
  FRANCHISE
}

enum FranchiseOpeningSource {
  SYSTEM_PROVISION
  HISTORICAL_ATTESTATION
}

enum CustomerMemberStatus {
  ACTIVE
  SUSPENDED
  CANCEL_PENDING
  CANCELLED
}

enum CustomerPointReasonCode {
  COMPENSATION
  REWARD
  CORRECTION
}

enum CustomerPointSource {
  HQ_MANUAL
}

enum CustomerPointOperationKind {
  GRANT
  REVERSE
  CORRECT
}

enum CustomerCouponGrantStatus {
  PENDING_ACTIVATION
  REVOKED
}

enum CustomerCouponDistributionJobKind {
  TEMPLATE_FANOUT
  MEMBER_CATCHUP
}

enum CustomerCouponDistributionJobStatus {
  PENDING
  RUNNING
  COMPLETED
}

enum StockMovementKind {
  RECEIVE
  UNPACK
  COUNT_ADJUSTMENT
  LOSS
}

enum StocktakeStatus {
  COUNTING
  REVIEW
  POSTED
  CANCELED
}

enum StorePromotionKind {
  ITEM_PRICE
  AMOUNT_THRESHOLD
  QUANTITY_THRESHOLD
