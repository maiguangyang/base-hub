type Subscription {
  webSocket: Any
}

enum ObjectSortType {
  ASC
  DESC
}

directive @format on FIELD_DEFINITION

directive @validator(required: String, immutable: String, type: String, minLength: Int, maxLength: Int, minValue: Int, maxValue: Int, unique: String, uniqueScope: String) on INPUT_FIELD_DEFINITION

directive @hasRole(role: Role!) on FIELD_DEFINITION

enum Role {
  ALL
  ADMIN
  USER
  GUEST
}

input FileField {
  hash: String!
  file: Upload!
}

input LoginInput {
  phone: String!
  password: String!
}

input ChangePasswordInput {
  currentPassword: String!
  newPassword: String!
}

input SelectWorkspaceInput {
  workspaceType: WorkspaceType!
  organizationId: ID
}

input ProvisionFranchiseInput {
  code: String!
  name: String!
  ownerPhone: String!
  ownerDisplayName: String!
  ownerEmail: String
}

input InviteOperatorInput {
  phone: String!
  displayName: String!
  email: String
  roleIds: [ID!]!
  storeAccessMode: StoreAccessMode!
  storeIds: [ID!]!
}

input ReviewStoreInput {
  storeId: ID!
  approved: Boolean!
  rejectionReason: String
}

enum StoreDocumentKind {
  BUSINESS_LICENSE
  OTHER
}

input SuspendOrganizationInput {
  organizationId: ID!
  reasonCode: String!
}

input ChangeMembershipStatusInput {
  membershipId: ID!
  status: MembershipStatus!
}

type Workspace {
  workspaceType: WorkspaceType!
  organizationId: ID
  organizationName: String!
  homePath: String!
}

type Viewer {
  account: Account!
  currentWorkspace: Workspace
  workspaces: [Workspace!]!
  permissions: [String!]!
}

type LoginPayload {
  viewer: Viewer!
  requiresPasswordChange: Boolean!
}

type ProvisionFranchisePayload {
  organization: Organization!
  membership: OperatorMembership!
