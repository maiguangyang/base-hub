}

type TemporaryPasswordPayload {
  accountId: ID!
  temporaryPassword: String!
}

enum SessionEventCode {
  SESSION_REVOKED
  ORGANIZATION_SUSPENDED
  CREDENTIALS_CHANGED
}

type SessionEvent {
  code: SessionEventCode!
  sessionId: ID!
  organizationId: ID
  occurredAt: Time!
}

