{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "codegen.ts", "src/**/*"],
  "exclude": ["dist", "node_modules", "src/__generated__"],
  "compilerOptions": {
    "types": ["astro/client"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
